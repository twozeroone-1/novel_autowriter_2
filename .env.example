GOOGLE_API_KEY="여기에_구글_API_키를_입력하세요(여러_개일_경우_쉼표(,)로_구분)"
# 토큰 비용이 가장 저렴한 모델로 설정 변경 (필요에 따라 변경 가능)
GEMINI_MODEL="gemini-3-flash-preview"

# 플랫폼 계정 env fallback 예시
# secure storage(keyring)를 쓸 수 없는 환경에서만 사용하세요.
# 프로젝트별 우선순위:
# NOVEL_AUTOWRITER_<PROJECT>_<PLATFORM>_USERNAME / PASSWORD
# 플랫폼 공통 fallback:
# NOVEL_AUTOWRITER_<PLATFORM>_USERNAME / PASSWORD
#
# 예시:
# NOVEL_AUTOWRITER_1_MUNPIA_USERNAME=""
# NOVEL_AUTOWRITER_1_MUNPIA_PASSWORD=""
# NOVEL_AUTOWRITER_1_NOVELPIA_USERNAME=""
# NOVEL_AUTOWRITER_1_NOVELPIA_PASSWORD=""
# NOVEL_AUTOWRITER_MUNPIA_USERNAME=""
# NOVEL_AUTOWRITER_MUNPIA_PASSWORD=""
# NOVEL_AUTOWRITER_NOVELPIA_USERNAME=""
# NOVEL_AUTOWRITER_NOVELPIA_PASSWORD=""
